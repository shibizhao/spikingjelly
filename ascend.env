# 创建conda环境
conda create -n demo python=3.9
conda activate demo

# 安装torch
pip install torch==2.3.1 -i https://mirrors.tuna.tsinghua.edu.cn/pypi/web/simple
pip install pyyaml -i https://mirrors.tuna.tsinghua.edu.cn/pypi/web/simple
pip install setuptools -i https://mirrors.tuna.tsinghua.edu.cn/pypi/web/simple
pip install torch-npu==2.3.1 -i https://mirrors.tuna.tsinghua.edu.cn/pypi/web/simple
pip install numpy==1.26.4 -i https://mirrors.tuna.tsinghua.edu.cn/pypi/web/simple

export ASCEND_LAUNCH_BLOCKING=1
pip install decorator==5.1.1 scipy==1.13.1 attrs==24.2.0 psutil==6.0.0 -i https://mirrors.tuna.tsinghua.edu.cn/pypi/web/simple

